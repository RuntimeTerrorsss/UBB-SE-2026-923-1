sequenceDiagram
    participant User
    participant Controller as AccountController
    participant Service as UserService
    participant Proxy as UserAPIProxy
    participant API as UsersController (API)
    participant Repo as UserRepository
    participant Db as AppDbContext

    User->>Controller: POST /Account/Register

    Note over Controller: Validate ModelState

    alt ModelState invalid
        Controller-->>User: Return error messages
    else ModelState valid
        Controller->>Service: RegisterUserAsync(user)

        Note over Service: AreFieldsEmpty()

        alt Fields empty
            Service-->>Controller: true
            Controller-->>User: Return error messages
        else Fields not empty
            Service->>Proxy: Register(newUser)
            Proxy->>API: POST /users/register
            API->>Repo: Register(newUser)

            Note over Repo: Check if username/email are unique
            Repo->>Db: dbContext.Users.AnyAsync(user => user.Username == newUser.Username || user.Email == newUser.Email)

            alt Already exists
                Repo-->>API: false
                API-->>Proxy: 400 Bad Request
                Proxy-->>Service: false
                Service-->>Controller: false
                Controller-->>User: Return error messages
            else Not exists
                Repo->>Db: dbContext.Users.AddAsync(newUser)
                Repo->>Db: dbContext.SaveChangesAsync()
                Repo-->>API: true
                API-->>Proxy: 200 OK
                Proxy-->>Service: true
                Service-->>Controller: true

                Note over Controller: Auto-login user
                Controller-->>User: Redirect to /Home/Index
            end
        end
    end