sequenceDiagram
    actor User
    participant View as Client (Browser)
    participant Controller as HomeController
    participant SearchSvc as InterfaceSearchAndFilterService
    participant Repo as GamesRepository
    participant DB as AppDbContext (Database)

    User->>Controller: GET / (Home/Index)

    alt User is Logged In
        Note over Controller: IsLoggedIn == true
        Controller->>Controller: filter.UserId = CurrentUserId
        
        Controller->>SearchSvc: SearchGamesByFilter(filter)
        SearchSvc->>Repo: GetGamesByFilter(filter)
        
        Note over Repo, DB: Excludes games owned by CurrentUserId
        Repo->>DB: Query Active Games (OwnerId != CurrentUserId)
        DB-->>Repo: Returns List<Game>
        Repo-->>SearchSvc: Returns List<Game>
        
        Note over SearchSvc: Maps Entities to GameDTOs
        SearchSvc-->>Controller: Returns GameDTO[]
        
        Controller->>View: Render Index.cshtml with Model
        Note over View: Renders Top Bar: Dashboard, Chat, Logout
        Note over View: Renders Game Cards: Link -> Game Details Page
        View-->>User: Displays Homepage (Clickable Game Cards)

    else User is Logged Out
        Note over Controller: IsLoggedIn == false
        Controller->>Controller: filter.UserId = null (Leaves default)
        
        Controller->>SearchSvc: SearchGamesByFilter(filter)
        SearchSvc->>Repo: GetGamesByFilter(filter)
        
        Note over Repo, DB: Defaults to AnonymousUserId (-1)
        Repo->>DB: Query All Active Games (OwnerId != -1)
        DB-->>Repo: Returns List<Game>
        Repo-->>SearchSvc: Returns List<Game>
        
        Note over SearchSvc: Maps Entities to GameDTOs
        SearchSvc-->>Controller: Returns GameDTO[]
        
        Controller->>View: Render Index.cshtml with Model
        Note over View: Renders Top Bar: Login Button
        Note over View: Renders Game Cards: Link -> "#" (Triggers Login Modal)
        View-->>User: Displays Homepage (Restricted Game Cards)
    end