sequenceDiagram
    actor User
    participant GamesController
    participant BookingService
    participant GamesAPIProxy
    participant UserAPIProxy
    participant RentalAPIProxy
    participant API_GamesController as API GamesController
    participant API_UsersController as API UsersController
    participant API_RentalsController as API RentalsController
    participant AppDbContext

    User->>GamesController: GET /Games/Details/{id}
    GamesController->>BookingService: GetBookingInformationForSpecificGame(id)
    BookingService->>GamesAPIProxy: GetGameById(id)
    GamesAPIProxy->>API_GamesController: GET /api/games/{id}
    API_GamesController->>AppDbContext: GetGameById(id)
    AppDbContext-->>API_GamesController: return Game
    API_GamesController-->>GamesAPIProxy: return Game
    GamesAPIProxy-->>BookingService: return Game
    BookingService->>UserAPIProxy: GetGameById(ownerId)
    UserAPIProxy->>API_UsersController: GET /api/users/{ownerId}
    API_UsersController->>AppDbContext: GetById(ownerId)
    AppDbContext-->>API_UsersController: return User
    API_UsersController-->>UserAPIProxy: return User
    UserAPIProxy-->>BookingService: return User (owner)
    BookingService-->>GamesController: return BookingDTO
    GamesController->>BookingService: GetUnavailableTimeRanges(id)
    BookingService->>RentalAPIProxy: GetUnavailableTimeRanges(id)
    RentalAPIProxy->>API_RentalsController: GET /api/rentals/game/{id}/unavailable
    API_RentalsController->>AppDbContext: GetUnavailableTimeRanges(id)
    AppDbContext-->>API_RentalsController: return List<TimeRange>
    API_RentalsController-->>RentalAPIProxy: return List<TimeRange>
    RentalAPIProxy-->>BookingService: return List<TimeRange>
    BookingService-->>GamesController: return TimeRange[]
    GamesController-->>User: return View(booking + calendar)