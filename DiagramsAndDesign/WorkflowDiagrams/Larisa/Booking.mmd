sequenceDiagram
    actor Renter
    participant GamesController
    participant BookingService
    participant RentalAPIProxy
    participant RentalsController
    participant ConversationRepository
    participant AppDbContext

    Renter->>GamesController: GET /Games/ConfirmBooking?id&startDate&endDate
    GamesController->>BookingService: GetBookingInformationForSpecificGame(id)
    BookingService->>RentalAPIProxy: GET /api/games/{id}
    RentalAPIProxy->>AppDbContext: dbContext.Games.Find(id)
    AppDbContext-->>RentalAPIProxy: return Game entity
    RentalAPIProxy-->>BookingService: return BookingDTO
    BookingService-->>GamesController: return BookingDTO
    GamesController->>BookingService: CheckGameAvailability(id, timeRange)
    BookingService->>RentalAPIProxy: POST /api/rentals/{id}/check
    RentalAPIProxy->>AppDbContext: CheckGameAvailability(start, end, gameId)
    AppDbContext-->>RentalAPIProxy: return bool
    RentalAPIProxy-->>BookingService: return true/false

    alt not available
        BookingService-->>GamesController: false
        GamesController-->>Renter: redirect to Details with error
    else available
        GamesController-->>Renter: return View (confirm page + price)
        Renter->>GamesController: POST /Games/ConfirmBooking (confirm)
        GamesController->>BookingService: AddBooking(id, clientId, timeRange)
        BookingService->>RentalAPIProxy: POST /api/rentals/book
        RentalAPIProxy->>RentalsController: BookGameWithRentalRequest(clientId, gameId, dates)
        RentalsController->>AppDbContext: CheckGameAvailability again
        AppDbContext-->>RentalsController: available
        RentalsController->>AppDbContext: AddRental(rental)
        AppDbContext-->>RentalsController: saved
        RentalsController->>ConversationRepository: FindOrCreateConversationBetweenUsers(clientId, ownerId)
        ConversationRepository-->>RentalsController: conversationId
        RentalsController->>ConversationRepository: HandleNewMessage(RentalRequestMessage)
        ConversationRepository->>AppDbContext: save message
        AppDbContext-->>ConversationRepository: saved
        ConversationRepository-->>RentalsController: done
        RentalsController-->>RentalAPIProxy: HTTP 200 OK (rentalId)
        RentalAPIProxy-->>BookingService: done
        BookingService-->>GamesController: done
        GamesController-->>Renter: redirect to /Chats (success)
    end