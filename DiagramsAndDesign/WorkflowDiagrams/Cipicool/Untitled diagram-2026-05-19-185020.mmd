sequenceDiagram
    actor User
    participant Controller as RentalsController
    participant CashSvc as CashPaymentService
    participant PayRepo as IPaymentRepository
    participant ConvSvc as ConversationService
    participant ConvRepo as IConversationRepository
    participant DB as Database (AppDbContext)

    User->>Controller: POST ConfirmCashPayment(rentalId, messageId)

    %% --- PAYMENT SAVING FLOW ---
    Controller->>CashSvc: AddCashPaymentAsync(DTO)
    
    CashSvc->>PayRepo: AddPaymentAsync(paymentEntity)
    PayRepo->>DB: Insert Payment (State="COMPLETED", Method="CASH")
    DB-->>PayRepo: Return New ID
    PayRepo-->>CashSvc: Return paymentIdentifier
    
    Note over CashSvc, PayRepo: Service generates Receipt Path using the new ID
    
    CashSvc->>PayRepo: UpdatePaymentAsync(paymentEntity)
    PayRepo->>DB: Update Payment (Add Receipt Path)
    DB-->>PayRepo: Success
    PayRepo-->>CashSvc: Success
    
    CashSvc-->>Controller: Return paymentIdentifier

    %% --- CONVERSATION UPDATING FLOW ---
    Controller->>ConvSvc: Initialize(userId)
    
    Controller->>ConvSvc: OnCardPaymentSelected(messageId)
    
    ConvSvc->>ConvSvc: FinalizeRentalRequest(messageId)
    ConvSvc->>ConvRepo: HandleRentalRequestFinalization(messageId)
    
    ConvRepo->>DB: Update Message (Discriminator: RentalRequestMessage)
    DB-->>ConvRepo: Returns Updated Entity
    ConvRepo-->>ConvSvc: Success
    
    ConvSvc-->>Controller: Task Completed

    Controller-->>User: Redirect to PaymentHistory/Index