sequenceDiagram
    actor User
    participant Controller as RentalsController
    participant CashSvc as CashPaymentService
    participant PayRepo as IPaymentRepository
    participant ConvSvc as ConversationService
    participant ConvRepo as IConversationRepository
    participant DB as Database (AppDbContext)

    User->>Controller: POST ConfirmCashPayment(rentalId, messageId)

    Controller->>CashSvc: AddCashPaymentAsync(DTO)
    CashSvc->>PayRepo: AddPaymentAsync(paymentEntity)
    PayRepo->>DB: Insert Payment (Cash)
    DB-->>CashSvc: paymentId
    
    Note over CashSvc, PayRepo: generates receipt path using the new ID
    
    CashSvc->>PayRepo: UpdatePaymentAsync(paymentEntity)
    PayRepo->>DB: Save receipt path
    CashSvc-->>Controller: paymentId

    Controller->>ConvSvc: Initialize(userId)
    
    Controller->>ConvSvc: OnCashPaymentSelected(messageId) 
    
    ConvSvc->>ConvRepo: HandleRentalRequestFinalization(messageId)
    ConvRepo->>DB: Update message status
    
    Controller->>User: Redirect to PaymentHistory/Index