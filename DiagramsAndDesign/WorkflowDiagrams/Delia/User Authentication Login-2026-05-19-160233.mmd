sequenceDiagram
    actor User
    participant View as Login.cshtml
    participant AccountController as AccountController.cs
    participant UserService as UserService.cs
    participant Proxy as UserAPIProxy.cs
    participant Api as UsersController.cs
    participant Repo as UserRepository.cs
    participant Ctx as AppDbContext.cs
    participant DB as SQL Server Database
    participant Session as SessionHelper.cs

    User->>View: fills form and submits
    View->>AccountController: POST Login(LoginViewModel)
    AccountController->>UserService: LoginAsync(identifier, password)
    UserService->>Proxy: Login(identifier, password)
    Proxy->>Api: POST api/users/login(LoginRequest)
    Api->>Repo: Login(emailOrUsername, password)
    Repo->>Repo: GetByIdentifier(emailOrUsername)
    Repo->>Ctx: Users.FirstOrDefaultAsync(...)
    Ctx->>DB: SELECT FROM Users
    DB-->>Ctx: User?
    Ctx-->>Repo: User?

    alt login failed
        Repo-->>Api: null
        Api-->>Proxy: 401 Unauthorized
        Proxy-->>UserService: null
        UserService-->>AccountController: null
        AccountController->>AccountController: ModelState.AddModelError(...)
        AccountController-->>View: View(loginViewModel)
        View-->>User: shows login error
    else login successful
        Repo->>Repo: user.PasswordHash == password
        Repo-->>Api: User
        Api-->>Proxy: 200 OK(User)
        Proxy-->>UserService: User
        UserService-->>AccountController: User
        AccountController->>Session: SetUser(...)
        Session-->>AccountController: session saved
        AccountController-->>View: RedirectToAction("Index", "Home")
        View-->>User: redirects to Home page
    end