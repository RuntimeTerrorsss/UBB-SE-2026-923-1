@model BookingDTO
@using BookingBoardGames.Sharing.DTO

@{
    ViewData["Title"] = Model.Name;
    var unavailableRanges = ViewBag.UnavailableRanges as TimeRange[] ?? Array.Empty<TimeRange>();
}

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            @if (Model.ImageUrl != null && Model.ImageUrl.Length > 0)
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name"
                     style="height:250px; object-fit:cover; width:100%;" />
            }
            else
            {
            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:250px">
                <span class="text-muted">No image available</span>
            </div>
            }
        </div>

        <div class="col-md-8">
            <h1>@Model.Name</h1>
            <p class="text-muted">@Model.Description</p>

            <table class="table table-borderless">
                <tr>
                    <th>Price per day</th>
                    <td>@Model.Price.ToString("C")</td>
                </tr>
                <tr>
                    <th>City</th>
                    <td>@Model.City</td>
                </tr>
                <tr>
                    <th>Players</th>
                    <td>@Model.MinimumNrPlayers – @Model.MaximumNumberPlayers</td>
                </tr>
                <tr>
                    <th>Owner</th>
                    <td>@Model.DisplayName</td>
                </tr>
            </table>

            <hr />
            <h4>Book this game</h4>

            @if (unavailableRanges.Length > 0)
            {
            <div class="alert alert-warning">
                <strong>Unavailable periods:</strong>
                <ul class="mb-0">
                    @foreach (var range in unavailableRanges)
                        {
                    <li>@range.StartTime.ToShortDateString() – @range.EndTime.ToShortDateString()</li>
                        }
                </ul>
            </div>
            }

            <form asp-action="ConfirmBooking" asp-route-id="@Model.GameId" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="startDate" class="form-control" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">End Date</label>
                        <input type="date" name="endDate" class="form-control" required
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Book</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
