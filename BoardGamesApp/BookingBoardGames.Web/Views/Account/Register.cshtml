@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .register-wrapper {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .register-card {
        background: #fff;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 32px rgba(0,0,0,0.10);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 560px;
    }

    .register-card h2 {
        font-weight: 700;
        letter-spacing: -0.5px;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .register-card .subtitle {
        color: #6c757d;
        font-size: 0.92rem;
        margin-bottom: 1.75rem;
    }

    .section-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #adb5bd;
        margin: 1.4rem 0 0.75rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #343a40;
        margin-bottom: 0.3rem;
    }

    .form-control {
        border-radius: 0.5rem;
        border: 1.5px solid #dee2e6;
        font-size: 0.95rem;
        padding: 0.55rem 0.85rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        border-color: #4361ee;
        box-shadow: 0 0 0 3px rgba(67,97,238,0.13);
    }

    .form-control.input-error {
        border-color: #dc3545;
    }

    .field-hint {
        font-size: 0.78rem;
        color: #adb5bd;
        margin-top: 0.2rem;
    }

    .btn-register {
        background: #4361ee;
        border: none;
        border-radius: 0.5rem;
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        padding: 0.65rem;
        letter-spacing: 0.3px;
        transition: background 0.2s, transform 0.1s;
        width: 100%;
        margin-top: 0.5rem;
    }

    .btn-register:hover {
        background: #3451d1;
    }

    .btn-register:active {
        transform: scale(0.99);
    }

    .btn-register:disabled {
        background: #7c93f3;
        cursor: not-allowed;
    }

    .divider {
        border: none;
        border-top: 1.5px solid #f1f3f5;
        margin: 1.5rem 0 1rem;
    }

    .login-link {
        text-align: center;
        font-size: 0.88rem;
        color: #6c757d;
    }

    .login-link a {
        color: #4361ee;
        font-weight: 600;
        text-decoration: none;
    }

    .login-link a:hover {
        text-decoration: underline;
    }

    .password-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #adb5bd;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
    }

    .toggle-password:hover {
        color: #495057;
    }

    .strength-bar {
        height: 4px;
        border-radius: 2px;
        background: #e9ecef;
        margin-top: 0.4rem;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        border-radius: 2px;
        width: 0%;
        transition: width 0.3s, background 0.3s;
    }

    .strength-text {
        font-size: 0.75rem;
        margin-top: 0.2rem;
        font-weight: 600;
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <h2>Create an account</h2>
        <p class="subtitle">Start renting and sharing board games in your area.</p>

        <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

                <div class="section-label">Account</div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="e.g. boardlover42" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DisplayName" class="form-label">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" placeholder="e.g. Alex B." />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                    <div class="section-label">Password</div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" class="form-control" id="passwordInput"
                                   placeholder="Min. 6 characters" autocomplete="new-password" />
                            <button type="button" class="toggle-password" data-target="passwordInput" title="Show/hide password">
                                toggle
                            </button>
                        </div>
                        <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                        <div class="strength-text" id="strengthText"></div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="password-wrapper">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordInput"
                                   placeholder="Repeat your password" autocomplete="new-password" />
                            <button type="button" class="toggle-password" data-target="confirmPasswordInput" title="Show/hide password">
                                toggle
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                        <div class="section-label">Location</div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" placeholder="e.g. Cluj-Napoca" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Country" class="form-label">Country <span class="text-danger">*</span></label>
                                <input asp-for="Country" class="form-control" placeholder="e.g. Romania" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                        </div>

                            <div class="section-label">Optional details</div>

                            <div class="row g-3">
                                <div class="col-sm-8">
                                    <label asp-for="Street" class="form-label">Street</label>
                                    <input asp-for="Street" class="form-control" placeholder="e.g. Strada Memorandumului" />
                                    <span asp-validation-for="Street" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-4">
                                    <label asp-for="StreetNumber" class="form-label">Number</label>
                                    <input asp-for="StreetNumber" class="form-control" placeholder="e.g. 12A" />
                                    <span asp-validation-for="StreetNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +40 712 345 678" autocomplete="tel" />
                                <p class="field-hint">Used so owners and renters can contact each other.</p>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                                <hr class="divider" />

                                <button type="submit" class="btn-register" id="submitBtn">
                                    Create account
                                </button>
                            </form>

                            <p class="login-link mt-3">
                                Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
                            </p>

                        </div>
                    </div>

                    @section Scripts {
                        @await Html.PartialAsync("_ValidationScriptsPartial")

                        <script>
                            $(function () {

                                // toggle password visibility
                                $(".toggle-password").on("click", function () {
                                    const targetId = $(this).data("target");
                                    const input = $("#" + targetId);
                                    const isPassword = input.attr("type") === "password";
                                    input.attr("type", isPassword ? "text" : "password");
                                    $(this).text(isPassword ? "🙈" : "👁");
                                });

                                // password strength indicator
                                $("#passwordInput").on("input", function () {
                                    const val = $(this).val();
                                    let score = 0;
                                    if (val.length >= 6)  score++;
                                    if (val.length >= 10) score++;
                                    if (/[A-Z]/.test(val)) score++;
                                    if (/[0-9]/.test(val)) score++;
                                    if (/[^A-Za-z0-9]/.test(val)) score++;

                                    const levels = [
                                        { label: "",         color: "",        width: "0%" },
                                        { label: "Weak",     color: "#dc3545", width: "25%" },
                                        { label: "Fair",     color: "#fd7e14", width: "50%" },
                                        { label: "Good",     color: "#ffc107", width: "75%" },
                                        { label: "Strong",   color: "#198754", width: "90%" },
                                        { label: "Very strong", color: "#0d6efd", width: "100%" },
                                    ];

                                    const lvl = levels[Math.min(score, 5)];
                                    $("#strengthFill").css({ width: lvl.width, background: lvl.color });
                                    $("#strengthText").text(lvl.label).css("color", lvl.color);
                                });

                                // disable submit on valid submit (prevent double-click)
                                $("#registerForm").on("submit", function () {
                                    const isValid = $(this).valid();
                                    if (isValid) {
                                        $("#submitBtn").prop("disabled", true).text("Creating account…");
                                    }
                                });

                            });
                        </script>
                    }
